{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/*.!(html)",
      "backup/**",
      ".git/**",
      ".firebase/**",
      ".claude/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
